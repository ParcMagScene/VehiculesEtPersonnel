# Variables d'environnement pour le serveur backend
# Copiez ce fichier en .env et modifiez les valeurs

# Port du serveur
PORT=3002
NODE_ENV=production

# Secret JWT — OBLIGATOIRE : générez une clé unique avec :
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGEZ_CETTE_CLE

# Domaines autorisés pour CORS (séparés par des virgules)
# En prod, ne garder que les domaines réels — les localhost sont ajoutés automatiquement en dev
ALLOWED_ORIGINS=https://votre-domaine.example.com

# Durée de vie du token JWT (en jours)
JWT_EXPIRY_DAYS=7

# Nom du cookie d'authentification (défaut: auth_token).
# IMPORTANT : utiliser un nom différent en dev (ex. auth_token_dev) pour éviter
# que dev et prod sur localhost ne se déconnectent mutuellement.
#COOKIE_NAME=auth_token

# Clé de chiffrement AES-256-GCM (mots de passe caméra + secrets TOTP 2FA)
# 64 hex chars = 32 bytes
# Générez avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VIDEO_CIPHER_KEY=CHANGEZ_CETTE_CLE

# IP du serveur (pour les logs uniquement)
SERVER_HOST=192.168.x.x

# Nom de l'entreprise (affiché dans les exports PDF, congés, etc.)
COMPANY_NAME=Mon Entreprise

# Google Calendar (optionnel — laisser vide pour désactiver)
GOOGLE_CALENDAR_ID=

# Google Service Account (recommandé)
# Option A : JSON complet en variable d'environnement (échappé sur une ligne)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_SERVICE_ACCOUNT_JSON=
# Option B : chemin vers le fichier clé JSON (server-side uniquement)
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/absolute/path/to/service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Sync bidirectionnelle eM@g -> Google Calendar
# false (défaut) = lecture seule, true/1 = autorise les écritures côté Google
GOOGLE_BIDIRECTIONAL_SYNC=false

# Rétention des sauvegardes automatiques (en jours)
BACKUP_RETENTION_DAYS=30

# Chemin de la base de données (défaut: vehicules.db en prod, vehicules-dev.db en dev)
# DB_PATH=vehicules.db

# Autoriser les cookies HTTP (sans Secure) derrière un reverse proxy terminant TLS
# ALLOW_HTTP=true

# MediaMTX — URLs du serveur vidéo (optionnel, défaut: localhost)
# MEDIAMTX_API_URL=http://127.0.0.1:9997
# MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889
#
# [SEC T-P0-17] Sécurité MediaMTX : voir docs/02-Securite/VIDEO_HARDENING.md
# - `mediamtx.yml` doit binder API et RTSP sur 127.0.0.1 (loopback).
# - Aucun port MediaMTX (9997, 8554, 8889) exposé sur le WAN.
# - VIDEO_CIPHER_KEY (ci-dessus) obligatoire en prod (AES-256-GCM sur
#   les mots de passe caméras persistés en DB).

# ─── [eM@g 3.0 — Feature flags API v2] ───
# Active le namespace /api/v2/planning/* (T-P0-03+). OFF par défaut.
# Valeurs ON acceptées : 1 | true | yes | on (case-insensitive). Toute autre valeur
# ou absence : les routes v2 renvoient 404 (comportement voulu, ne pas divulguer).
# FEATURE_V2_PLANNING=0

# Active le namespace /api/v2/display/* (T-P0-14+). OFF par défaut.
# Endpoints publics : GET /api/v2/display/protocol (discovery, pas d'auth).
# Endpoints skeletons : /config, /content, /signals repondent 501 tant que
# la refonte metier (T-P0-15 DisplayService) n'est pas terminee.
# FEATURE_V2_DISPLAY=0

# Active le namespace /api/v2/locations/* + PATCH /api/v2/equipment/:id/location
# (T-P0-12). OFF par défaut. Endpoints : /protocol (public), /depots,
# /depots/:id, PATCH equipment/:id/location (audit trail via
# equipment_location_history). Coexistence stricte avec les endpoints v1
# (/api/equipment-depot-zones, etc.).
# FEATURE_V2_LOCATIONS=0

# Active le namespace /api/v2/affaires/* (T-P0-09). OFF par défaut.
# Endpoints : /protocol (public), GET /affaires (cursor-based),
# GET /affaires/:numero, GET /affaires/:numero/history,
# PATCH /affaires/:numero (audit trail systematique via affaire_history).
# Coexistence stricte avec /api/affaires v1 (aucune desactivation).
# FEATURE_V2_AFFAIRES=0

# Active le sous-systeme WebSocket (T-P1-02). OFF par defaut.
# URL : ws(s)://host/api/v2/ws/<namespace>
# Namespaces livres : `meta` (heartbeat + ping/pong + whoami).
# Namespaces declares mais pas encore implementes : `messaging`, `display`
# (T-P1-02b). Auth : cookie httpOnly `auth_token` OU header
# Authorization: Bearer OU query ?token=... Si off, tout upgrade WS
# repond 404 immediatement (comportement HTTP standard).
# FEATURE_V2_WEBSOCKET=0

# Active le namespace /api/v2/leaves/* (T-P1-04). OFF par defaut.
# Endpoints : /protocol (public), POST /calculate (miroir v1 payload
# v2), GET /balance/mine (self-service), GET /balance/:person_id
# (admin). Coexistence stricte avec /api/leaves/* v1 (aucune desactivation).
# FEATURE_V2_LEAVES=0

# Active le namespace /api/v2/conflicts/* (T-P1-05). OFF par defaut.
# Endpoints : /protocol (public), POST /check (detection de conflits
# agenda pour une personne). Aucune ecriture, aucun bloquage sur les
# mutations v1. Sources scannees : availabilities, missions +
# mission_assignments, task_assignments.
# FEATURE_V2_CONFLICTS=0

# Active le namespace /api/v2/equipment-uid/* + POST regenerate-uid
# (T-P1-06). OFF par defaut. Endpoints : /protocol (public), GET
# /audit (doublons serial_number/uid, equipments sans uid) [admin],
# POST /equipment/:id/regenerate-uid [admin]. Utilise getNextUid
# (uid_counter) avec anti-collision. Audit dans equipment.notes.
# FEATURE_V2_EQUIPMENT_UID=0

# Active le namespace /api/v2/sav/* (T-P1-07). OFF par defaut.
# Endpoints : /protocol (public), GET /tickets/:id/parts, POST
# /tickets/:id/parts, PATCH /parts/:id/status, POST /tickets/:id/
# transition (machine d'etat renforcee). Necessite la migration
# sav-parts-v1 (auto au boot backend, additive).
# FEATURE_V2_SAV=0

# Active le namespace /api/v2/equipment-assignments/* + POST
# /api/v2/equipment/:id/assignments (T-P1-08). OFF par defaut.
# Endpoints : /protocol (public), POST /equipment/:id/assignments
# (double-assign bloquee), POST /:aid/release, GET /equipment/:id/
# assignments/history, GET /:aid/history. Necessite la migration
# equipment-assignment-history-v1 (auto au boot backend, additive).
# FEATURE_V2_EQUIPMENT_ASSIGNMENTS=0

# Active le namespace /api/v2/orders/* + /api/v2/quotes/*
# (T-P1-09). OFF par defaut. Endpoints : /protocol (public + expose
# les 2 matrices ORDER/QUOTE), POST /orders/:id/transition, POST
# /quotes/:id/transition. Reutilise ORDER_TRANSITIONS +
# QUOTE_TRANSITIONS de apps/api/orders/_helpers.js.
# FEATURE_V2_ORDERS=0

# URL de l'API (utilisé par les scripts utilitaires, ex: import-backup.js)
# API_URL=http://localhost:3002/api

# [SEC PHASE 3] Sessions inactives révoquées après N heures (0 = désactivé, défaut 24 en prod)
SESSION_IDLE_TIMEOUT_HOURS=24

# [SEC PHASE 3] CSP en mode rapport pour collecter les violations sans bloquer
CSP_REPORT_ONLY=true

# ─── [S2-4] Observabilité Sentry (optionnel) ───
# Laisser vide pour désactiver. Quand défini, installer aussi: npm i @sentry/node
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_RATE=0.1
SENTRY_RELEASE=
