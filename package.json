{
  "name": "emag",
  "version": "2.0.0",
  "private": true,
  "description": "eM@g - Gestion de parc matériel et personnel (monorepo)",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:backend": "cd apps/api && NODE_ENV=development node server.js --dev",
    "dev:start": "bash scripts/dev-start.sh",
    "dev:reset-db": "bash scripts/dev-reset-db.sh",
    "build": "npm run build --workspace=apps/web",
    "preview": "npm run preview --workspace=apps/web",
    "deploy": "bash scripts/safe-deploy.sh",
    "lint": "npm run lint --workspace=apps/web",
    "lint:fix": "npm run lint:fix --workspace=apps/web",
    "format": "npm run format --workspace=apps/web",
    "format:check": "npm run format:check --workspace=apps/web",
    "update-photos": "node scripts/generate-photo-list.js",
    "watch-photos": "node scripts/watch-photos.js",
    "smoke-test": "node scripts/smoke-test.js",
    "test": "node --test tests/unit.test.js",
    "test:api": "node --test tests/api-integration.test.js",
    "test:all": "node --test tests/"
  },
  "devDependencies": {
    "md-to-pdf": "^5.2.5"
  }
}
