# ═══════════════════════════════════════════════
# Configuration DÉVELOPPEMENT — Backend séparé
# ═══════════════════════════════════════════════
# Ce fichier est utilisé UNIQUEMENT en mode dev
# La production utilise .env (port 3002, vehicules.db)
# ═══════════════════════════════════════════════

# Port différent de la production (3002)
PORT=3003
NODE_ENV=development

# Base de données SÉPARÉE (copie de la prod)
DB_PATH=vehicules-dev.db

# Clé JWT (peut être différente de la prod)
JWT_SECRET=dev-secret-key-not-for-production

# Domaines autorisés (CORS) — uniquement localhost en dev
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:4173,http://127.0.0.1:5174

# Durée de vie du token JWT (en jours)
JWT_EXPIRY_DAYS=30
