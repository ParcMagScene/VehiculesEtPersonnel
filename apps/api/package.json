{
  "name": "vehicules-backend",
  "version": "1.0.0",
  "description": "Backend API pour le système de réservation de véhicules",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development nodemon server.js -- --dev",
    "lint": "eslint . --ext js --max-warnings=0",
    "lint:fix": "eslint . --ext js --fix",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^9.2.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.1",
    "otpauth": "^9.5.0",
    "pdfkit": "^0.17.2",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "sonos": "^1.14.3",
    "xss": "^1.0.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "nodemon": "^3.0.2"
  }
}
